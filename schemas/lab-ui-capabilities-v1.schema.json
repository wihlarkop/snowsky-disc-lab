      },
      "maxItems": 11,
      "title": "Declared",
      "type": "array"
    },
    "unsupported": {
      "items": {
        "$ref": "#/$defs/CapabilityName"
      },
      "maxItems": 11,
      "title": "Unsupported",
      "type": "array"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "declared",
    "unsupported"
  ],
  "title": "CapabilityDeclaration",
  "type": "object"
}
